# Railway all-in-one image built from the existing GHCR images
# Combine content extracted from the existing images into one container

# Extract the binary from the backend image
FROM ghcr.io/oko-trading/okotrading/oko-backend:latest AS backend

# Extract static files from the frontend image
FROM ghcr.io/oko-trading/okotrading/oko-frontend:latest AS frontend

# Final image
FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata sqlite nginx openssl gettext

# Copy the backend binary
COPY --from=backend /app/oko /app/oko

# Copy TA-Lib libraries
COPY --from=backend /usr/local/lib/libta_lib* /usr/local/lib/
RUN ldconfig /usr/local/lib 2>/dev/null || true

# Copy frontend static files
COPY --from=frontend /usr/share/nginx/html /usr/share/nginx/html

WORKDIR /app
RUN mkdir -p /app/data

# Startup script, including nginx configuration generation
COPY railway/start.sh /app/start.sh
RUN chmod +x /app/start.sh

ENV DB_PATH=/app/data/data.db

# Railway sets the PORT environment variable automatically
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-8080}/health || exit 1

CMD ["/app/start.sh"]
