# OKO Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Frontend origin port, bound to 127.0.0.1 by Docker Compose
OKO_FRONTEND_PORT=3000

# Timezone
OKO_TIMEZONE=Europe/London

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Keep enabled when the application is served through Cloudflare Tunnel
TRANSPORT_ENCRYPTION=true

# ===========================================
# Optional: External Services
# ===========================================

# Telegram notifications (optional)
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# Wallet Analyzer APIs
# ANKR_API_TOKEN=         # Ankr Advanced API for EVM balances (https://www.ankr.com/rpc/advanced-api)
# HELIUS_API_KEY=         # Helius API for Solana balances (https://www.helius.dev)
# COINGECKO_API_KEY=      # CoinGecko API for price stats (https://www.coingecko.com/en/api/pricing)

# Upgrade holder gate — Robinhood Chain mainnet defaults to chain ID 4663.
# UPGRADE_TOKEN_ADDRESS=0x... # Required ERC-20 contract address on Robinhood Chain
# UPGRADE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# UPGRADE_CHAIN_ID=4663
# UPGRADE_MIN_TOKEN_BALANCE=150000

# required
#GROK_API_KEY=
#GROK_MODEL=grok-3-latest


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db

# PostgreSQL alternative (uncomment these and replace the SQLite settings)
# DB_TYPE=postgres
# DB_HOST=postgres.example.internal
# DB_PORT=5432
# DB_USER=oko_user
# DB_PASSWORD=change-this
# DB_NAME=oko
# DB_SSLMODE=require
